[Unit]
Description=HashBurst Monero Testnet PoC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monero-testnet
Group=monero-testnet
ExecStart=/opt/monero/0.18.5.1/monerod --config-file /etc/hashburst/monero/testnet.conf --non-interactive
Restart=on-failure
RestartSec=10
Nice=10
CPUQuota=400%
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
