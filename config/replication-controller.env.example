HB_REPL_DB=/var/lib/hashburst/replication/controller.sqlite3
HB_STORAGE_NODES=/etc/hashburst/storage-nodes.json
HB_REPL_BIND=127.0.0.1
HB_REPL_PORT=8095
HB_REPL_MODE=observe
HB_REPL_N=3
HB_REPL_M=2
HB_REPL_REPAIR_INTERVAL=30
HB_REPL_EDGE_GRACE_SEC=21600
HB_REPL_COMMITTABLE_GRACE_SEC=60
HB_REPL_VERIFY_INTERVAL_SEC=900
HB_REPL_NODE_STALE_SEC=90
HB_REPL_ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
HB_REPL_NODE_TOKEN=REPLACE_WITH_RANDOM_NODE_SECRET
