[Unit]
Description=HashBurst logical K325T ingress
After=network-online.target hashburst-tep.service hashburst-ha-agent.service
Wants=network-online.target
Requires=hashburst-tep.service hashburst-ha-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/hashburst-ha/hashburst_ha_ingress.py --bind 127.0.0.1 --port 49010
Restart=always
RestartSec=2
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
