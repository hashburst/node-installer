[Unit]
Description=HashBurst Replication Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/hashburst/replication-controller.env
ExecStart=/usr/bin/python3 /opt/hashburst/replication/hb_replication_controller.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hashburst/replication /var/log/hashburst

[Install]
WantedBy=multi-user.target
