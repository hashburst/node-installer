[Unit]
Description=HashBurst Blockchain Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hashburst-node
Restart=always
RestartSec=10
User=root
EnvironmentFile=-/etc/hashburst/env
StandardOutput=append:/var/log/hashburst/node.log
StandardError=append:/var/log/hashburst/node.log

[Install]
WantedBy=multi-user.target
