[Unit]
Description=HashBurst HA disaster-recovery readiness producer
After=network-online.target hashburst-node.service hashburst-tep.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/hashburst-ha/hashburst_ha_readiness.py --config /etc/hashburst/ha.json --output /var/lib/hashburst/ha/replication.json
Restart=always
RestartSec=2
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hashburst/ha

[Install]
WantedBy=multi-user.target
