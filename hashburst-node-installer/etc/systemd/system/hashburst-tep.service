[Unit]
Description=HashBurst TEP — Transport Encrypted Protocol
Documentation=https://patents.google.com/patent/US11799659B2/en
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/hashburst-tep/hb_tep.py --node-id NODE_ID --listen 0.0.0.0 --log-level INFO
Restart=always
RestartSec=5
User=root
EnvironmentFile=-/etc/hashburst/env
ReadWritePaths=/var/lib/hashburst /var/log/hashburst

[Install]
WantedBy=multi-user.target
