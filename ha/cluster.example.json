{
  "cluster_id": "hashburst-production",
  "node_id": "hashburst-dr1",
  "roles": ["candidate", "voter"],
  "voters": [
    "blockchainapi.one",
    "hashburst-witness-1",
    "hashburst-dr1"
  ],
  "candidates": [
    {"node_id": "master-node", "priority": 10},
    {"node_id": "hashburst-dr1", "priority": 20}
  ],
  "lease_seconds": 12,
  "loop_seconds": 2,
  "rpc_timeout_seconds": 2.5,
  "armed": false,
  "primary_services": [
    "hashburst-master.service"
  ],
  "required_services": [
    "hashburst-node.service",
    "hashburst-tep.service",
    "hashburst-monero-mainnet.service",
    "hashburst-monero-testnet.service"
  ],
  "health_urls": ["http://127.0.0.1:8009/api/health"],
  "monero_checks": [
    {"name": "mainnet", "url": "http://127.0.0.1:18081/json_rpc", "nettype": "mainnet", "max_height_lag": 2},
    {"name": "testnet", "url": "http://127.0.0.1:28081/json_rpc", "nettype": "testnet", "max_height_lag": 2}
  ],
  "readiness_files": [],
  "replication_sources": [],
  "replication_state_file": "/var/lib/hashburst/ha/replication.json",
  "max_replication_lag_seconds": 30,
  "startup_grace_seconds": 0,
  "tep_status_url": "http://127.0.0.1:47778/",
  "tep_rpc_url": "http://127.0.0.1:47781/app/ha-lease",
  "bind_host": "127.0.0.1",
  "bind_port": 47780
}
